// Dedicated pigments for light-mode shader materials. No output filtering.
export fn lightPaper() -> vec3f { return vec3f(0.9568627, 0.9803922, 0.9647059); }
export fn lightSurface() -> vec3f { return vec3f(0.8470588, 0.9333333, 0.8862745); }
export fn lightInk() -> vec3f { return vec3f(0.0666667, 0.2352941, 0.1960784); }
export fn lightEmerald() -> vec3f { return vec3f(0.0000000, 0.4862745, 0.3450980); }
export fn lightCyan() -> vec3f { return vec3f(0.0000000, 0.5450980, 0.7215686); }
export fn lightBlue() -> vec3f { return vec3f(0.1568627, 0.3686275, 0.9098039); }
export fn lightViolet() -> vec3f { return vec3f(0.5098039, 0.2666667, 0.8470588); }
export fn lightRose() -> vec3f { return vec3f(0.8392157, 0.2352941, 0.5137255); }
export fn lightGold() -> vec3f { return vec3f(0.8431373, 0.5764706, 0.1137255); }
