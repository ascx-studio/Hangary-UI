      "path": "hangry/components/card.tsx",
      "content": "import { memo, type ComponentProps, type ReactNode } from \"react\";\nimport { cn } from \"cn\";\n\n// Legacy content props remain supported for existing consumers.\nconst cardSizes = {\n  sm: \"gap-4 px-4 py-4\",\n  md: \"gap-6 px-6 py-6\",\n} as const;\n\ntype CardProps = {\n  size?: keyof typeof cardSizes;\n  title?: string;\n  description?: string;\n  footer?: ReactNode;\n} & (\n  | ({ as?: \"article\" } & Omit<ComponentProps<\"article\">, \"title\">)\n  | ({ as: \"a\" } & Omit<ComponentProps<\"a\">, \"title\">)\n);\n\nconst Card = memo(function Card({\n  title,\n  description,\n  children,\n  footer,\n  className,\n  size = \"md\",\n  ...props\n}: CardProps) {\n  const hasLegacyContent = Boolean(title || description || footer);\n  const classes = cn(\n    \"group/card flex w-full max-w-sm flex-col rounded-lg surface-raised text-base leading-7\",\n    \"outline-ring focus-visible:outline-[length:var(--focus-ring-width,2px)] focus-visible:outline-offset-[var(--focus-ring-offset,2px)]\",\n    \"[a&]:transition-colors [a&]:duration-[var(--duration-fast,150ms)] [a&]:ease-out [a&]:hover:[--surface-bottom:var(--muted)] motion-reduce:transition-none\",\n    cardSizes[size],\n    className,\n  );\n  const content = (\n    <>\n      {(title || description) && (\n        <CardHeader>\n          {title && <CardTitle>{title}</CardTitle>}\n          {description && <CardDescription>{description}</CardDescription>}\n        </CardHeader>\n      )}\n      {hasLegacyContent ? children && <CardContent>{children}</CardContent> : children}\n      {footer && <CardFooter>{footer}</CardFooter>}\n    </>\n  );\n  if (props.as === \"a\") {\n    const { as: Tag, ...anchorProps } = props;\n    return (\n      <Tag data-slot=\"card\" data-size={size} className={classes} {...anchorProps}>\n        {content}\n      </Tag>\n    );\n  }\n  const { as: Tag = \"article\", ...articleProps } = props;\n  return (\n    <Tag data-slot=\"card\" data-size={size} className={classes} {...articleProps}>\n      {content}\n    </Tag>\n  );\n});\n\nconst CardHeader = memo(function CardHeader({ className, ...props }: ComponentProps<\"header\">) {\n  return (\n    <header\n      data-slot=\"card-header\"\n      className={cn(\n        \"grid auto-rows-min items-start gap-x-4 gap-y-2 has-[[data-slot=card-action]]:grid-cols-[1fr_auto]\",\n        className,\n      )}\n      {...props}\n    />\n  );\n});\n\nconst CardTitle = memo(function CardTitle({ className, ...props }: ComponentProps<\"h3\">) {\n  return (\n    <h3 data-slot=\"card-title\" className={cn(\"typography-section-title\", className)} {...props} />\n  );\n});\n\nconst CardDescription = memo(function CardDescription({\n  className,\n  ...props\n}: ComponentProps<\"p\">) {\n  return (\n    <p\n      data-slot=\"card-description\"\n      className={cn(\"col-start-1\", \"typography-body\", className)}\n      {...props}\n    />\n  );\n});\n\nconst CardAction = memo(function CardAction({ className, ...props }: ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"card-action\"\n      className={cn(\"col-start-2 row-span-2 row-start-1 self-start justify-self-end\", className)}\n      {...props}\n    />\n  );\n});\n\nconst CardContent = memo(function CardContent({ className, ...props }: ComponentProps<\"div\">) {\n  return <div data-slot=\"card-content\" className={className} {...props} />;\n});\n\nconst CardFooter = memo(function CardFooter({ className, ...props }: ComponentProps<\"footer\">) {\n  return (\n    <footer\n      data-slot=\"card-footer\"\n      className={cn(\"flex items-center border-t border-border pt-4\", className)}\n      {...props}\n    />\n  );\n});\n\nexport { Card, CardAction, CardContent, CardDescription, CardFooter, CardHeader, CardTitle };\n",
      "type": "registry:component",
      "target": "@components/hangry-ui/components/card.tsx"
    },
    {
      "path": "hangry/components/button.tsx",
      "content": "import { memo, type ComponentProps } from \"react\";\n\ntype ButtonProps = {\n  variant?: \"primary\" | \"secondary\" | \"ghost\" | \"destructive\" | \"outline\";\n} & ((ComponentProps<\"button\"> & { href?: never }) | (ComponentProps<\"a\"> & { href: string }));\n\nexport function buttonClassName(variant: ButtonProps[\"variant\"] = \"primary\", className = \"\") {\n  const styles = {\n    primary:\n      \"[--button-color:var(--color-emerald-400)] [--button-top:var(--color-emerald-300)] [--button-stroke-top:var(--color-emerald-200)] [--button-stroke-bottom:var(--color-emerald-700)] text-neutral-950\",\n    secondary: \"[--button-color:var(--secondary)] text-secondary-foreground\",\n    ghost: \"bg-transparent text-foreground hover:bg-muted\",\n    destructive: \"[--button-color:var(--destructive)] text-destructive-foreground\",\n    outline:\n      \"[--button-color:var(--background)] [--button-top:var(--background)] [--button-bottom:var(--muted)] [--button-stroke-top:var(--border)] [--button-stroke-bottom:color-mix(in_srgb,var(--foreground)_25%,var(--border))] text-foreground hover:[--button-top:var(--muted)]\",\n  };\n  const surface =\n    variant === \"ghost\"\n      ? \"\"\n      : \"border border-transparent [background:linear-gradient(to_bottom,var(--button-top,color-mix(in_srgb,var(--button-color)_88%,white)),var(--button-bottom,var(--button-color)))_padding-box,linear-gradient(to_bottom,var(--button-stroke-top,color-mix(in_srgb,var(--button-color)_65%,white)),var(--button-stroke-bottom,color-mix(in_srgb,var(--button-color)_65%,black)))_border-box] shadow-[0_1px_2px_rgb(0_0_0/0.12),0_4px_8px_-2px_rgb(0_0_0/0.18)] hover:[--button-top:color-mix(in_srgb,var(--button-color)_78%,white)]\";\n  return `inline-flex min-h-11 items-center justify-center gap-2 rounded-lg px-5 py-2 text-sm font-semibold  transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring disabled:pointer-events-none disabled:opacity-50 ${surface} ${styles[variant] ?? styles.primary} ${className}`;\n}\n\nexport const Button = memo(function Button({\n  children = \"Get started\",\n  variant = \"primary\",\n  className = \"\",\n  ...props\n}: ButtonProps = {}) {\n  const classes = buttonClassName(variant, className);\n\n  if (props.href !== undefined) {\n    return (\n      <a className={classes} {...props}>\n        {children}\n      </a>\n    );\n  }\n\n  return (\n    <button type=\"button\" className={classes} {...props}>\n      {children}\n    </button>\n  );\n});\n",
      "type": "registry:component",
      "target": "@components/hangry-ui/components/button.tsx"
    },
