{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "card-stack",
  "title": "Card Stack",
  "description": "Square-edged cards with fine borders and stacked background layers.",
  "dependencies": [
    "motion@^14.3.0"
  ],
  "files": [
    {
      "path": "registry/components/card-stack.tsx",
      "content": "\"use client\";\n\nimport { memo, useState, type ReactNode } from \"react\";\nimport * as motion from \"motion/react-client\";\nimport { useReducedMotion } from \"motion/react\";\nimport { Card } from \"./card\";\nimport { Button } from \"./button\";\nimport { typography } from \"../lib/typography.shared\";\n\nexport interface CardStackItem {\n  id: string;\n  title: string;\n  description?: string;\n  src?: string;\n  alt?: string;\n  children?: ReactNode;\n}\n\ninterface CardStackProps {\n  items?: readonly CardStackItem[];\n  className?: string;\n  label?: string;\n}\n\nconst defaultItems: readonly CardStackItem[] = [\n  { id: \"front\", title: \"A little depth. A different perspective.\", description: \"A simple stack for your next idea.\", src: \"/1.png\", alt: \"Glowing white butterflies on black\" },\n  { id: \"middle\", title: \"The next layer\", description: \"A different view, just beneath the surface.\", src: \"/2.png\", alt: \"White light swirling around a dark center\" },\n  { id: \"back\", title: \"Room for more\", description: \"There is always another perspective to explore.\", src: \"/3.png\", alt: \"A monochrome field of stars and clouds\" },\n];\n\nexport const CardStack = memo(function CardStack({\n  items = defaultItems,\n  className = \"\",\n  label = \"Card stack\",\n}: CardStackProps = {}) {\n  const reducedMotion = useReducedMotion();\n  const [selectedId, setSelectedId] = useState<string | null>(null);\n  const cards = items.slice(0, 3);\n  const selected = cards.find(item => item.id === selectedId) ?? cards[0];\n  if (!selected) return null;\n  const ordered = [selected, ...cards.filter(item => item.id !== selected.id)];\n\n  return (\n    <section aria-label={label} className={`w-full max-w-2xl pt-10 ${className}`}>\n      <div className=\"relative isolate\">\n        {ordered.map((item, depth) => (\n          <motion.div\n            layout={!reducedMotion}\n            transition={{ type: \"spring\", stiffness: 280, damping: 30 }}\n            key={item.id}\n            style={{ zIndex: 3 - depth, top: depth === 0 ? undefined : -depth * 20, left: depth === 0 ? undefined : `${depth * 2.5}%`, right: depth === 0 ? undefined : `${depth * 2.5}%` }}\n            className={depth === 0 ? \"relative\" : \"absolute bottom-0\"}\n          >\n            <Card title=\"\" description=\"\" className=\"relative h-full w-full! max-w-none! overflow-hidden border-white/15! bg-black! p-0! shadow-[0_-1px_0_rgb(255_255_255/0.08),0_-8px_20px_rgb(0_0_0/0.65),0_24px_48px_-16px_rgb(0_0_0/0.8)]!\">\n              <Button\n                variant=\"ghost\"\n                aria-label={`Show ${item.title}`}\n                aria-pressed={depth === 0}\n                onClick={() => setSelectedId(item.id)}\n                className=\"absolute inset-x-0 top-0 z-10 h-5! min-h-0! w-full p-0! hover:bg-white/5 focus-visible:outline-offset-[-2px]\"\n              />\n              {depth === 0 && (\n                <motion.div\n                  initial={{ opacity: reducedMotion ? 1 : 0 }}\n                  animate={{ opacity: 1 }}\n                  transition={{ duration: reducedMotion ? 0 : 0.2 }}\n                  className=\"p-6 sm:p-10\"\n                >\n                  <div className=\"mb-6 h-0.5 w-16 bg-primary\" />\n                  <h3 className={`${typography.sectionTitle} text-white!`}>{item.title}</h3>\n                  {item.description && <p className={`mt-3 ${typography.body} text-white/60!`}>{item.description}</p>}\n                  {item.children ?? (item.src && (\n                    // A native image keeps the registry component framework-independent.\n                    // eslint-disable-next-line @next/next/no-img-element\n                    <img src={item.src} alt={item.alt ?? \"\"} width={640} height={320} loading=\"lazy\" decoding=\"async\" className=\"mt-8 aspect-[2/1] w-full object-cover\" />\n                  ))}\n                </motion.div>\n              )}\n            </Card>\n          </motion.div>\n        ))}\n      </div>\n    </section>\n  );\n});\n",
      "type": "registry:component",
      "target": "@components/hangry-ui/components/card-stack.tsx"
    },
    {
      "path": "registry/components/card.tsx",
      "content": "import { typography } from \"../lib/typography.shared\";\nimport type { ComponentProps, ReactNode } from \"react\";\n\ninterface CardProps extends Omit<ComponentProps<\"article\">, \"title\"> {\n  title?: string;\n  description?: string;\n  footer?: ReactNode;\n}\n\nexport function Card({ title = \"Room for your next idea\", description = \"A simple starting point for something great. Make it yours.\", children, footer, className = \"\", ...props }: CardProps = {}) {\n  return <article className={`w-full max-w-sm border border-border bg-card p-6 text-base leading-7 text-card-foreground shadow-sm ${className}`} {...props}>\n    {title && <h3 className={typography.sectionTitle}>{title}</h3>}\n    {description && <p className={`mt-2 ${typography.body}`}>{description}</p>}\n    {children && <div className={title || description || footer ? \"mt-5\" : \"h-full min-h-0\"}>{children}</div>}\n    {footer && <footer className=\"mt-5 border-t border-border pt-4\">{footer}</footer>}\n  </article>;\n}\n",
      "type": "registry:component",
      "target": "@components/hangry-ui/components/card.tsx"
    },
    {
      "path": "registry/components/button.tsx",
      "content": "import { memo, type ComponentProps } from \"react\";\n\ntype ButtonProps = {\n  variant?: \"primary\" | \"secondary\" | \"ghost\" | \"destructive\" | \"outline\";\n} & (ComponentProps<\"button\"> & { href?: never } | ComponentProps<\"a\"> & { href: string });\n\nexport const Button = memo(function Button({\n  children = \"Get started\",\n  variant = \"primary\",\n  className = \"\",\n  ...props\n}: ButtonProps = {}) {\n  const styles = {\n    primary: \"bg-emerald-400 text-neutral-950 hover:bg-emerald-300\",\n    secondary: \"bg-neutral-800 text-white hover:bg-neutral-700\",\n    ghost: \"bg-transparent text-foreground hover:bg-muted\",\n    destructive: \"bg-destructive text-destructive-foreground hover:bg-destructive/90\",\n    outline: \"border border-border text-white hover:bg-neutral-800\",\n  };\n  const classes = `inline-flex min-h-11 items-center justify-center gap-2 px-5 py-2 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-400 disabled:pointer-events-none disabled:opacity-50 ${styles[variant] ?? styles.primary} ${className}`;\n\n  if (props.href !== undefined) {\n    return <a className={classes} {...props}>{children}</a>;\n  }\n\n  return (\n    <button\n      type=\"button\"\n      className={classes}\n      {...props}\n    >\n      {children}\n    </button>\n  );\n});\n",
      "type": "registry:component",
      "target": "@components/hangry-ui/components/button.tsx"
    },
    {
