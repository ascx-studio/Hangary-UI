{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "logo",
  "title": "Logo",
  "description": "Renders the brand logo with support for compact icon and full wordmark variants.",
  "dependencies": [],
  "files": [
    {
      "path": "registry/nova-blue/ui/logo.tsx",
      "content": "import Image, { type ImageProps } from 'next/image'\n\nexport type LogoVariant = 'logo' | 'wordmark'\n\nconst logoVariants: Record<LogoVariant, Pick<ImageProps, 'src' | 'alt' | 'width' | 'height'>> = {\n  logo: {\n    src: '/logo.png',\n    alt: 'Logo',\n    width: 40,\n    height: 40,\n  },\n  wordmark: {\n    src: '/wordmark.png',\n    alt: 'Wordmark',\n    width: 160,\n    height: 40,\n  },\n}\n\nexport type LogoProps = Readonly<{\n  variant?: LogoVariant\n}> &\n  Pick<ImageProps, 'className' | 'priority' | 'sizes'>\n\nexport function Logo({ variant = 'wordmark', ...imageProps }: LogoProps) {\n  const logo = logoVariants[variant]\n\n  return (\n    <Image\n      src={logo.src}\n      alt={logo.alt}\n      width={logo.width}\n      height={logo.height}\n      {...imageProps}\n    />\n  )\n}\n\nexport default Logo\n",
      "type": "registry:ui",
      "target": "@components/lazy-ui/ui/logo.tsx"
    },
    {
      "path": "registry/nova-blue/styles/portfolio.css",
      "content": "@theme inline {\n  --color-primary-light: var(--primary);\n  --color-primary-hover: var(--primary);\n  --color-accent-cyan: var(--secondary);\n  --color-accent-purple: var(--primary);\n  --color-info: var(--primary);\n  --shadow-glow: 0 0 20px color-mix(in oklab, var(--primary) 15%, transparent);\n  --shadow-glow-lg: 0 0 30px color-mix(in oklab, var(--primary) 25%, transparent);\n  --font-heading: var(--font-sans);\n}\n\n@layer components {\n  /* Example utility combining the new theme variables */\n  .btn-primary-glow {\n    @apply bg-primary text-primary-foreground shadow-glow hover:shadow-glow-lg\n           transition-all duration-200 active:scale-95;\n  }\n\n  .blog-content > table,\n  .blog-content > .table-wrapper > table {\n    width: 100%;\n    margin: 2rem 0;\n    border-collapse: separate;\n    border-spacing: 0;\n    overflow: hidden;\n    border: 1px solid var(--border);\n    background: color-mix(in oklab, var(--background) 60%, transparent);\n    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);\n    font-size: 0.95rem;\n  }\n\n  .blog-content > table[header-row=\"true\"] tbody tr:first-child td,\n  .blog-content > table thead th,\n  .blog-content > .table-wrapper > table[header-row=\"true\"] tbody tr:first-child td,\n  .blog-content > .table-wrapper > table thead th {\n    background: color-mix(in oklab, var(--muted) 40%, transparent);\n    color: var(--foreground);\n    font-size: 0.625rem;\n    font-weight: 700;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n  }\n\n  .blog-content > table td,\n  .blog-content > table th,\n  .blog-content > .table-wrapper > table td,\n  .blog-content > .table-wrapper > table th {\n    padding: 0.9rem 1rem;\n    border-bottom: 1px solid var(--border);\n    text-align: left;\n    vertical-align: top;\n    color: var(--muted-foreground);\n  }\n\n  .blog-content > table tr:last-child td,\n  .blog-content > table tr:last-child th,\n  .blog-content > .table-wrapper > table tr:last-child td,\n  .blog-content > .table-wrapper > table tr:last-child th {\n    border-bottom: 0;\n  }\n\n  .blog-content > table td code,\n  .blog-content > table th code,\n  .blog-content > .table-wrapper > table td code,\n  .blog-content > .table-wrapper > table th code {\n    display: inline-block;\n    padding: 0.1rem 0.35rem;\n    border-radius: calc(var(--radius) * 0.45);\n    background: var(--muted);\n    color: var(--foreground);\n    font-family: var(--font-sans);\n    font-size: 0.85em;\n    font-weight: 600;\n  }\n\n\n}\n",
      "type": "registry:file",
      "target": "@components/lazy-ui/styles/portfolio.css"
    },
