{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "wordmark-light-ray",
  "title": "Wordmark Light Ray",
  "description": "A continuous blue-white light ray with a soft glow and fading trail across the wordmark.",
  "dependencies": [
    "vgpu@^0.6.0",
    "@vgpu/wgsl@^0.6.0"
  ],
  "files": [
    {
      "path": "registry/shader/wordmark-light-ray.tsx",
      "content": "\"use client\";\n\nimport { memo, useEffect, useRef } from \"react\";\nimport { clock, effect, frame, frameLoop, init, surface } from \"vgpu\";\nimport lightRayShader from \"./wordmark-light-ray.wgsl\";\n\nconst MARK_SIZE = [1337, 336] as const;\n\nexport const WordmarkLightRay = memo(function WordmarkLightRay() {\n  const canvasRef = useRef<HTMLCanvasElement>(null);\n  const markRef = useRef<HTMLDivElement>(null);\n\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    const mark = markRef.current;\n    if (!canvas || !mark) return;\n\n    let disposed = false;\n    let gpu: Awaited<ReturnType<typeof init>> | undefined;\n    let canvasSurface: ReturnType<typeof surface> | undefined;\n    let rayEffect: ReturnType<typeof effect> | undefined;\n    let stop: ReturnType<typeof frameLoop> | undefined;\n    let cleaned = false;\n    let pointerX = MARK_SIZE[0] * 0.5;\n    let pointerY = MARK_SIZE[1] * 0.5;\n    let hovering = false;\n    let renderStatic: (() => void) | undefined;\n\n    const onPointerMove = (event: PointerEvent) => {\n      const bounds = mark.getBoundingClientRect();\n      pointerX = ((event.clientX - bounds.left) / bounds.width) * MARK_SIZE[0];\n      pointerY = ((event.clientY - bounds.top) / bounds.height) * MARK_SIZE[1];\n      hovering = true;\n      renderStatic?.();\n    };\n    const onPointerLeave = () => {\n      hovering = false;\n      renderStatic?.();\n    };\n\n    const cleanup = () => {\n      if (cleaned) return;\n      cleaned = true;\n      stop?.stop();\n      mark.removeEventListener(\"pointermove\", onPointerMove);\n      mark.removeEventListener(\"pointerleave\", onPointerLeave);\n      rayEffect?.dispose();\n      canvasSurface?.dispose();\n      gpu?.dispose();\n    };\n\n    const start = async () => {\n      gpu = await init();\n      if (disposed) return cleanup();\n\n      canvasSurface = surface(gpu, canvas, { size: MARK_SIZE });\n      rayEffect = effect(gpu, lightRayShader, {\n        label: \"wordmark-light-ray\",\n        set: { cfg: { ray: [pointerX, pointerY, 0, 0] } },\n      });\n      await rayEffect.compile(canvasSurface);\n      if (disposed) return cleanup();\n\n      mark.addEventListener(\"pointermove\", onPointerMove);\n      mark.addEventListener(\"pointerleave\", onPointerLeave);\n      const time = clock(gpu);\n      const reducedMotion = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n      if (reducedMotion) {\n        renderStatic = () => {\n          rayEffect?.set({ cfg: { ray: [pointerX, pointerY, 0, hovering ? 1 : 0] } });\n          if (gpu && canvasSurface && rayEffect) {\n            frame(gpu, (currentFrame) => currentFrame.pass(canvasSurface!, rayEffect!));\n          }\n        };\n        renderStatic();\n      } else {\n        stop = frameLoop(gpu, (currentFrame) => {\n          rayEffect?.set({ cfg: { ray: [pointerX, pointerY, time.time, hovering ? 1 : 0] } });\n          if (canvasSurface && rayEffect) currentFrame.pass(canvasSurface, rayEffect);\n        });\n      }\n    };\n\n    void start().catch((error: unknown) => {\n      if (!disposed) console.error(\"Wordmark Light Ray could not start:\", error);\n      cleanup();\n    });\n\n    return () => {\n      disposed = true;\n      cleanup();\n    };\n  }, []);\n\n  return (\n    <div className=\"relative flex h-full w-full items-center justify-center overflow-hidden bg-black\">\n      <div\n        ref={markRef}\n        className=\"aspect-1337/336 w-[88%]\"\n        style={{\n          maskImage: \"url('/wordmark.svg')\",\n          maskPosition: \"center\",\n          maskRepeat: \"no-repeat\",\n          maskSize: \"contain\",\n          WebkitMaskImage: \"url('/wordmark.svg')\",\n          WebkitMaskPosition: \"center\",\n          WebkitMaskRepeat: \"no-repeat\",\n          WebkitMaskSize: \"contain\",\n        }}\n      >\n        <canvas ref={canvasRef}  className=\"block h-full w-full\" />\n      </div>\n    </div>\n  );\n});\n",
      "type": "registry:component",
      "target": "@components/hangry-ui/shader/wordmark-light-ray.tsx"
    },
    {
      "path": "registry/shader/wordmark-light-ray.wgsl",
      "content": "struct Config {\n  // Pointer in wordmark pixels, elapsed seconds, and hover state.\n  ray: vec4f,\n};\n\n@group(0) @binding(0) var<uniform> cfg: Config;\n\n@fragment fn fs_main(@location(0) uv: vec2f) -> @location(0) vec4f {\n  let pointer = cfg.ray.xy / vec2f(1337.0, 336.0);\n  // Start inside the mark so reduced motion still shows a complete beam.\n  let scan = fract(cfg.ray.z * 0.14 + 0.45) * 1.6 - 0.3;\n  let beam_x = mix(scan, pointer.x, cfg.ray.w);\n  let beam_y = mix(0.5, pointer.y, cfg.ray.w);\n  let offset = uv.x - beam_x + (uv.y - beam_y) * 0.14;\n  let core = exp(-pow(offset / 0.009, 2.0));\n  let halo = exp(-pow(offset / 0.065, 2.0));\n  // A broad, asymmetric wake makes the direction of the ray visible.\n  let trail = exp(min(offset, 0.0) / 0.15) * (1.0 - smoothstep(-0.005, 0.025, offset));\n  let color = vec3f(0.025, 0.045, 0.065)\n    + vec3f(0.1, 0.45, 0.8) * trail * 0.65\n    + vec3f(0.25, 0.7, 1.0) * halo * 0.65\n    + vec3f(0.85, 0.95, 1.0) * core;\n  return vec4f(color, 1.0);\n}\n",
      "type": "registry:file",
      "target": "@components/hangry-ui/shader/wordmark-light-ray.wgsl"
    },
