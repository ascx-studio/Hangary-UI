{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "scale-card",
  "title": "Scale Card",
  "description": "A portrait card framed by fading ruler marks on all four sides.",
  "dependencies": [
    "cn@^0.2.6"
  ],
  "files": [
    {
      "path": "hangry/components/scale-card.tsx",
      "content": "import { memo, type ComponentProps, type ReactNode } from \"react\";\nimport { AspectRatio } from \"./aspect-ratio\";\nimport { Card } from \"./card\";\nimport { Scales } from \"./scales\";\n\ninterface ScaleCardProps extends ComponentProps<\"div\"> {\n  src?: string;\n  alt?: string;\n  size?: number;\n  children?: ReactNode;\n}\n\nexport const ScaleCard = memo(function ScaleCard({\n  src = \"/1.webp\",\n  alt = \"Glowing white butterflies on a dark background\",\n  size = 8,\n  children,\n  className = \"\",\n  ...props\n}: ScaleCardProps = {}) {\n  return (\n    <div className={`relative mx-auto w-72 max-w-full ${className}`} {...props}>\n      <div className=\"pointer-events-none absolute inset-y-[-30%] -left-10 w-8 mask-t-from-90% mask-b-from-90%\">\n        <Scales size={size} orientation=\"vertical\" />\n      </div>\n      <div className=\"pointer-events-none absolute inset-y-[-30%] -right-10 w-8 mask-t-from-90% mask-b-from-90%\">\n        <Scales size={size} orientation=\"vertical\" />\n      </div>\n      <div className=\"pointer-events-none absolute inset-x-[-30%] -top-10 h-8 mask-r-from-90% mask-l-from-90%\">\n        <Scales size={size} />\n      </div>\n      <div className=\"pointer-events-none absolute inset-x-[-30%] -bottom-10 h-8 mask-r-from-90% mask-l-from-90%\">\n        <Scales size={size} />\n      </div>\n      <Card title=\"\" description=\"\" className=\"relative z-10 max-w-none overflow-hidden p-0!\">\n        <AspectRatio ratio={9 / 10}>\n          {children ?? (\n            // A native image keeps this registry component framework-independent.\n            // eslint-disable-next-line @next/next/no-img-element\n            <img\n              src={src}\n              alt={alt}\n              width={288}\n              height={320}\n              loading=\"lazy\"\n              decoding=\"async\"\n              className=\"h-full w-full object-cover\"\n            />\n          )}\n        </AspectRatio>\n      </Card>\n    </div>\n  );\n});\n",
      "type": "registry:component",
      "target": "@components/hangry-ui/components/scale-card.tsx"
    },
    {
      "path": "hangry/components/scales.tsx",
      "content": "import { memo, useId, type ComponentProps } from \"react\";\n\ninterface ScalesProps extends ComponentProps<\"svg\"> {\n  size?: number;\n  orientation?: \"horizontal\" | \"vertical\";\n}\n\nexport const Scales = memo(function Scales({\n  size = 8,\n  orientation = \"horizontal\",\n  className = \"\",\n  ...props\n}: ScalesProps = {}) {\n  const id = useId();\n  const spacing = Number.isFinite(size) && size > 0 ? size : 8;\n\n  return (\n    <svg\n      aria-hidden=\"true\"\n      focusable=\"false\"\n      className={`h-full w-full text-muted-foreground/40 ${className}`}\n      {...props}\n    >\n      <defs>\n        <pattern\n          id={id}\n          width={spacing * 5}\n          height=\"32\"\n          patternUnits=\"userSpaceOnUse\"\n          patternTransform={orientation === \"vertical\" ? \"rotate(90)\" : undefined}\n        >\n          <path\n            d={`M0 0V32 M${spacing} 10V22 M${spacing * 2} 10V22 M${spacing * 3} 10V22 M${spacing * 4} 10V22`}\n            fill=\"none\"\n            stroke=\"currentColor\"\n            strokeWidth=\"1\"\n          />\n        </pattern>\n      </defs>\n      <rect width=\"100%\" height=\"100%\" fill={`url(#${id})`} />\n    </svg>\n  );\n});\n",
      "type": "registry:component",
      "target": "@components/hangry-ui/components/scales.tsx"
    },
    {
      "path": "hangry/components/card.tsx",
      "content": "import { memo, type ComponentProps, type ReactNode } from \"react\";\nimport { cn } from \"cn\";\n\n// Legacy content props remain supported for existing consumers.\nconst cardSizes = {\n  sm: \"gap-4 px-4 py-4\",\n  md: \"gap-6 px-6 py-6\",\n} as const;\n\ntype CardProps = {\n  size?: keyof typeof cardSizes;\n  title?: string;\n  description?: string;\n  footer?: ReactNode;\n} & (\n  | ({ as?: \"article\" } & Omit<ComponentProps<\"article\">, \"title\">)\n  | ({ as: \"a\" } & Omit<ComponentProps<\"a\">, \"title\">)\n);\n\nconst Card = memo(function Card({\n  title,\n  description,\n  children,\n  footer,\n  className,\n  size = \"md\",\n  ...props\n}: CardProps) {\n  const hasLegacyContent = Boolean(title || description || footer);\n  const classes = cn(\n    \"group/card flex w-full max-w-sm flex-col rounded-lg surface-raised text-base leading-7\",\n    \"outline-ring focus-visible:outline-[length:var(--focus-ring-width,2px)] focus-visible:outline-offset-[var(--focus-ring-offset,2px)]\",\n    \"[a&]:transition-colors [a&]:duration-[var(--duration-fast,150ms)] [a&]:ease-out [a&]:hover:[--surface-bottom:var(--muted)] motion-reduce:transition-none\",\n    cardSizes[size],\n    className,\n  );\n  const content = (\n    <>\n      {(title || description) && (\n        <CardHeader>\n          {title && <CardTitle>{title}</CardTitle>}\n          {description && <CardDescription>{description}</CardDescription>}\n        </CardHeader>\n      )}\n      {hasLegacyContent ? children && <CardContent>{children}</CardContent> : children}\n      {footer && <CardFooter>{footer}</CardFooter>}\n    </>\n  );\n  if (props.as === \"a\") {\n    const { as: Tag, ...anchorProps } = props;\n    return (\n      <Tag data-slot=\"card\" data-size={size} className={classes} {...anchorProps}>\n        {content}\n      </Tag>\n    );\n  }\n  const { as: Tag = \"article\", ...articleProps } = props;\n  return (\n    <Tag data-slot=\"card\" data-size={size} className={classes} {...articleProps}>\n      {content}\n    </Tag>\n  );\n});\n\nconst CardHeader = memo(function CardHeader({ className, ...props }: ComponentProps<\"header\">) {\n  return (\n    <header\n      data-slot=\"card-header\"\n      className={cn(\n        \"grid auto-rows-min items-start gap-x-4 gap-y-2 has-[[data-slot=card-action]]:grid-cols-[1fr_auto]\",\n        className,\n      )}\n      {...props}\n    />\n  );\n});\n\nconst CardTitle = memo(function CardTitle({ className, ...props }: ComponentProps<\"h3\">) {\n  return (\n    <h3 data-slot=\"card-title\" className={cn(\"typography-section-title\", className)} {...props} />\n  );\n});\n\nconst CardDescription = memo(function CardDescription({\n  className,\n  ...props\n}: ComponentProps<\"p\">) {\n  return (\n    <p\n      data-slot=\"card-description\"\n      className={cn(\"col-start-1\", \"typography-body\", className)}\n      {...props}\n    />\n  );\n});\n\nconst CardAction = memo(function CardAction({ className, ...props }: ComponentProps<\"div\">) {\n  return (\n    <div\n      data-slot=\"card-action\"\n      className={cn(\"col-start-2 row-span-2 row-start-1 self-start justify-self-end\", className)}\n      {...props}\n    />\n  );\n});\n\nconst CardContent = memo(function CardContent({ className, ...props }: ComponentProps<\"div\">) {\n  return <div data-slot=\"card-content\" className={className} {...props} />;\n});\n\nconst CardFooter = memo(function CardFooter({ className, ...props }: ComponentProps<\"footer\">) {\n  return (\n    <footer\n      data-slot=\"card-footer\"\n      className={cn(\"flex items-center border-t border-border pt-4\", className)}\n      {...props}\n    />\n  );\n});\n\nexport { Card, CardAction, CardContent, CardDescription, CardFooter, CardHeader, CardTitle };\n",
      "type": "registry:component",
      "target": "@components/hangry-ui/components/card.tsx"
    },
    {
      "path": "hangry/components/aspect-ratio.tsx",
      "content": "import { memo, type ComponentProps, type CSSProperties } from \"react\";\nimport { cn } from \"cn\";\n\ninterface AspectRatioProps extends ComponentProps<\"div\"> {\n  ratio?: number;\n}\n\nexport const AspectRatio = memo(function AspectRatio({\n  ratio = 1,\n  className,\n  style,\n  ...props\n}: AspectRatioProps = {}) {\n  return (\n    <div\n      data-slot=\"aspect-ratio\"\n      style={{ \"--ratio\": ratio, ...style } as CSSProperties}\n      className={cn(\"relative aspect-(--ratio)\", className)}\n      {...props}\n    />\n  );\n});\n",
      "type": "registry:component",
      "target": "@components/hangry-ui/components/aspect-ratio.tsx"
    },
