{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "scale-card",
  "title": "Scale Card",
  "description": "A portrait card framed by fading ruler marks on all four sides.",
  "dependencies": [
    "cn@^0.2.6"
  ],
  "files": [
    {
      "path": "registry/components/scale-card.tsx",
      "content": "import { memo, type ComponentProps, type ReactNode } from \"react\";\nimport { AspectRatio } from \"./aspect-ratio\";\nimport { Card } from \"./card\";\nimport { Scales } from \"./scales\";\n\ninterface ScaleCardProps extends ComponentProps<\"div\"> {\n  src?: string;\n  alt?: string;\n  size?: number;\n  children?: ReactNode;\n}\n\nexport const ScaleCard = memo(function ScaleCard({\n  src = \"/1.png\",\n  alt = \"Glowing white butterflies on a dark background\",\n  size = 8,\n  children,\n  className = \"\",\n  ...props\n}: ScaleCardProps = {}) {\n  return (\n    <div className={`relative mx-auto w-72 max-w-full ${className}`} {...props}>\n      <div className=\"pointer-events-none absolute inset-y-[-30%] -left-10 w-8 mask-t-from-90% mask-b-from-90%\">\n        <Scales size={size} orientation=\"vertical\" />\n      </div>\n      <div className=\"pointer-events-none absolute inset-y-[-30%] -right-10 w-8 mask-t-from-90% mask-b-from-90%\">\n        <Scales size={size} orientation=\"vertical\" />\n      </div>\n      <div className=\"pointer-events-none absolute inset-x-[-30%] -top-10 h-8 mask-r-from-90% mask-l-from-90%\">\n        <Scales size={size} />\n      </div>\n      <div className=\"pointer-events-none absolute inset-x-[-30%] -bottom-10 h-8 mask-r-from-90% mask-l-from-90%\">\n        <Scales size={size} />\n      </div>\n      <Card title=\"\" description=\"\" className=\"relative z-10 max-w-none overflow-hidden p-0!\">\n        <AspectRatio ratio={9 / 10}>\n          {children ?? (\n            // A native image keeps this registry component framework-independent.\n            // eslint-disable-next-line @next/next/no-img-element\n            <img src={src} alt={alt} width={288} height={320} loading=\"lazy\" decoding=\"async\" className=\"h-full w-full object-cover\" />\n          )}\n        </AspectRatio>\n      </Card>\n    </div>\n  );\n});\n",
      "type": "registry:component",
      "target": "@components/hangry-ui/components/scale-card.tsx"
    },
    {
      "path": "registry/components/scales.tsx",
      "content": "import { memo, useId, type ComponentProps } from \"react\";\n\ninterface ScalesProps extends ComponentProps<\"svg\"> {\n  size?: number;\n  orientation?: \"horizontal\" | \"vertical\";\n}\n\nexport const Scales = memo(function Scales({\n  size = 8,\n  orientation = \"horizontal\",\n  className = \"\",\n  ...props\n}: ScalesProps = {}) {\n  const id = useId();\n  const spacing = Number.isFinite(size) && size > 0 ? size : 8;\n\n  return (\n    <svg\n      aria-hidden=\"true\"\n      focusable=\"false\"\n      className={`h-full w-full text-muted-foreground/40 ${className}`}\n      {...props}\n    >\n      <defs>\n        <pattern id={id} width={spacing * 5} height=\"32\" patternUnits=\"userSpaceOnUse\" patternTransform={orientation === \"vertical\" ? \"rotate(90)\" : undefined}>\n          <path\n            d={`M0 0V32 M${spacing} 10V22 M${spacing * 2} 10V22 M${spacing * 3} 10V22 M${spacing * 4} 10V22`}\n            fill=\"none\"\n            stroke=\"currentColor\"\n            strokeWidth=\"1\"\n          />\n        </pattern>\n      </defs>\n      <rect width=\"100%\" height=\"100%\" fill={`url(#${id})`} />\n    </svg>\n  );\n});\n",
      "type": "registry:component",
      "target": "@components/hangry-ui/components/scales.tsx"
    },
    {
      "path": "registry/components/card.tsx",
      "content": "import { typography } from \"../lib/typography.shared\";\nimport type { ComponentProps, ReactNode } from \"react\";\n\ninterface CardProps extends Omit<ComponentProps<\"article\">, \"title\"> {\n  title?: string;\n  description?: string;\n  footer?: ReactNode;\n}\n\nexport function Card({ title = \"Room for your next idea\", description = \"A simple starting point for something great. Make it yours.\", children, footer, className = \"\", ...props }: CardProps = {}) {\n  return <article className={`w-full max-w-sm border border-border bg-card p-6 text-base leading-7 text-card-foreground shadow-sm ${className}`} {...props}>\n    {title && <h3 className={typography.sectionTitle}>{title}</h3>}\n    {description && <p className={`mt-2 ${typography.body}`}>{description}</p>}\n    {children && <div className={title || description || footer ? \"mt-5\" : \"h-full min-h-0\"}>{children}</div>}\n    {footer && <footer className=\"mt-5 border-t border-border pt-4\">{footer}</footer>}\n  </article>;\n}\n",
      "type": "registry:component",
      "target": "@components/hangry-ui/components/card.tsx"
    },
    {
      "path": "registry/components/aspect-ratio.tsx",
      "content": "import { memo, type ComponentProps, type CSSProperties } from \"react\";\nimport { cn } from \"cn\";\n\ninterface AspectRatioProps extends ComponentProps<\"div\"> {\n  ratio?: number;\n}\n\nexport const AspectRatio = memo(function AspectRatio({\n  ratio = 1,\n  className,\n  style,\n  ...props\n}: AspectRatioProps = {}) {\n  return (\n    <div\n      data-slot=\"aspect-ratio\"\n      style={{ \"--ratio\": ratio, ...style } as CSSProperties}\n      className={cn(\"relative aspect-(--ratio)\", className)}\n      {...props}\n    />\n  );\n});\n",
      "type": "registry:component",
      "target": "@components/hangry-ui/components/aspect-ratio.tsx"
    },
