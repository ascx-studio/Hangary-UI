{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "footer-main",
  "title": "Footer Main",
  "description": "The Hangry UI site footer with navigation columns, social links, and spotlight artwork.",
  "dependencies": [
    "cn@^0.2.6",
    "motion@^14.3.0",
    "lucide-react@^1.48.0",
    "@ridemountainpig/svgl-react@^1.0.18"
  ],
  "files": [
    {
      "path": "registry/blocks/footer-main.tsx",
      "content": "import { memo, type ComponentProps } from \"react\";\nimport { cn } from \"cn\";\n\nimport * as motion from 'motion/react-client';\nimport Link from \"next/link\";\nimport { Heart } from \"lucide-react\";\nimport { GitHubDark } from \"@ridemountainpig/svgl-react\";\nimport Image from \"next/image\";\nimport { typography } from \"../lib/typography.shared\";\nimport { SpotlightReveal } from \"../components/spotlight-reveal\";\nimport { sampleMainFooterGroups, samplePageLinks } from \"../lib/navigation.shared\";\n\ntype FooterLink = { label: string; href: string };\ninterface FooterMainProps extends Omit<ComponentProps<\"footer\">, \"children\"> {\n  homeHref?: string;\n  githubHref?: string;\n  xHref?: string;\n  sponsorHref?: string;\n  groups?: readonly { title: string; links: readonly FooterLink[] }[];\n  quickLinks?: readonly FooterLink[];\n  logoSrc?: string;\n  artSrc?: string;\n  copyright?: string;\n}\n\nconst linkClass = \"rounded-sm text-muted-foreground hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring\";\nexport const FooterMain = memo(function FooterMain({\n  groups = sampleMainFooterGroups,\n  homeHref = \"#home\",\n  githubHref = \"#github\",\n  xHref = \"#x\",\n  sponsorHref = \"#sponsor\",\n  quickLinks = samplePageLinks,\n  logoSrc = \"/wordmark.svg\",\n  artSrc = \"/footerart.svg\",\n  copyright = \"© 2026 Hangry UI.\",\n  className,\n  ...props\n}: FooterMainProps = {}) {\n\n\n  return (\n    <>\n    <div  aria-hidden=\"true\" className=\"pointer-events-none -mb-px h-px w-full shrink-0\" />\n    <footer data-slot=\"footer-main\" {...props} className={cn(\"bottom-0 z-0 w-full shrink-0 overflow-hidden border-t border-border/50 bg-background\", className)}>\n      <div className=\"mx-auto w-full max-w-7xl px-6 pt-14 md:px-10 md:pt-20\">\n        <div className=\"grid grid-cols-2 gap-x-6 gap-y-12 pb-14 sm:grid-cols-3 md:gap-x-10 md:pb-20 lg:grid-cols-[1.2fr_repeat(3,minmax(0,1fr))]\">\n          <motion.div\n            className=\"col-span-2 space-y-5 motion-reduce:opacity-100! motion-reduce:transform-none! sm:col-span-3 lg:col-span-1\"\n            initial={{ opacity: 0, y: 16 }}\n            animate={ { opacity: 1, y: 0 } }\n            transition={{ duration: 0.5, ease: [0.22, 1, 0.36, 1] }}\n          >\n            <Link href={homeHref} aria-label=\"Hangry UI home\" className={`${linkClass} inline-block`}>\n              <Image src={logoSrc} alt=\"Hangry UI\" width={160} height={40} className=\"h-auto w-40\" />\n            </Link>\n            <p className={typography.caption}>{copyright}</p>\n          </motion.div>\n          {groups.map(({ title, links }, index) => (\n            <motion.nav\n              key={title}\n              aria-label={`Footer ${title.toLowerCase()}`}\n              className=\"motion-reduce:opacity-100! motion-reduce:transform-none!\"\n              initial={{ opacity: 0, y: 16 }}\n              animate={{ opacity: 1, y: 0 }}\n              transition={{ duration: 0.5, delay: (index + 1) * 0.1, ease: [0.22, 1, 0.36, 1] }}\n            >\n              <h2 className={typography.sectionTitle}>{title}</h2>\n              <ul className=\"mt-6 space-y-5\">\n                {links.map(({ label, href }) => (\n                  <li key={label}>\n                    <Link href={href} className={`${linkClass} inline-flex items-center gap-1.5 text-base`}>\n                      {label}\n                    </Link>\n                  </li>\n                ))}\n              </ul>\n            </motion.nav>\n          ))}\n        </div>\n        <motion.div\n          className=\"flex flex-col gap-6 border-t border-border/50 py-7 motion-reduce:opacity-100! motion-reduce:transform-none! sm:flex-row sm:items-center sm:justify-between\"\n          initial={{ opacity: 0, y: 12 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 0.5, delay: 0.2, ease: [0.22, 1, 0.36, 1] }}\n        >\n          <div className=\"flex items-center gap-6\">\n            <a href={xHref} aria-label=\"@razeevascx on X\" className={`${linkClass} inline-flex size-6 items-center justify-center text-2xl`}>\n              <span aria-hidden=\"true\">𝕏</span>\n            </a>\n            <a href={githubHref} aria-label=\"Hangry UI on GitHub\" className={linkClass}>\n              <GitHubDark className=\"size-6\" aria-hidden=\"true\" />\n            </a>\n            <Link href={sponsorHref} aria-label=\"Sponsor Hangry UI\" className={linkClass}>\n              <Heart size={23} aria-hidden=\"true\" />\n            </Link>\n          </div>\n          <p className={typography.caption}>\n            Built by <a href={xHref} className={linkClass}>@razeevascx</a>\n          </p>\n          <nav aria-label=\"Footer quick links\" className=\"flex flex-wrap gap-x-6 gap-y-3 text-sm\">\n            {quickLinks.map(({ label, href }) => (\n              <Link key={href} href={href} className={linkClass}>{label}</Link>\n            ))}\n          </nav>\n        </motion.div>\n        <motion.div\n          className=\"motion-reduce:opacity-100! motion-reduce:transform-none!\"\n          initial={{ opacity: 0, y: 20 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 0.7, ease: [0.22, 1, 0.36, 1] }}\n        >\n        <SpotlightReveal\n          variant=\"stroke\"\n          alt=\"\"\n          strokeSrc={artSrc}\n          className=\"mt-6 aspect-1062/224 h-auto w-full translate-y-[8%] sm:mt-10\"\n        />\n        </motion.div>\n      </div>\n    </footer>\n    </>\n  );\n});\n\n",
      "type": "registry:component",
      "target": "@components/hangry-ui/blocks/footer-main.tsx"
    },
    {
      "path": "registry/components/spotlight-reveal.tsx",
      "content": "\"use client\";\n\nimport { memo, type PointerEvent } from \"react\";\nimport Image from \"next/image\";\nimport * as motion from 'motion/react-client';\nimport { useMotionTemplate, useReducedMotion, useSpring } from \"motion/react\";\nimport { cn } from \"cn\";\n\nexport type SpotlightRevealProps = {\n  src?: string;\n  /** Choose filled artwork or an outline-only variation. */\n  variant?: \"default\" | \"stroke\";\n  /** Outline artwork matching src. Defaults to the local outlined wordmark. */\n  strokeSrc?: string;\n  alt?: string;\n  className?: string;\n};\n\nexport const SpotlightReveal = memo(function SpotlightReveal({\n  src = \"/wordmark.svg\",\n  variant = \"default\",\n  strokeSrc = \"/wordmark-stroke.svg\",\n  alt = \"\",\n  className,\n}: SpotlightRevealProps = {}) {\n  const reducedMotion = useReducedMotion();\n  const artwork = variant === \"stroke\" ? strokeSrc : src;\n  const x = useSpring(0, { stiffness: 300, damping: 30 });\n  const y = useSpring(0, { stiffness: 300, damping: 30 });\n  const mask = useMotionTemplate`radial-gradient(circle 120px at ${x}px ${y}px, black 20%, transparent 100%)`;\n\n  function trackPointer(event: PointerEvent<HTMLDivElement>) {\n    if (event.pointerType === \"touch\" || reducedMotion) return;\n    const bounds = event.currentTarget.getBoundingClientRect();\n    const nextX = event.clientX - bounds.left;\n    const nextY = event.clientY - bounds.top;\n    if (event.type === \"pointerenter\") {\n      x.jump(nextX);\n      y.jump(nextY);\n    } else {\n      x.set(nextX);\n      y.set(nextY);\n    }\n  }\n\n  return (\n    <motion.div\n      className={cn(\"group/spotlight relative h-64 w-[640px] max-w-full overflow-hidden\", className)}\n      initial=\"rest\"\n      whileHover={reducedMotion ? undefined : \"hover\"}\n      onPointerEnter={trackPointer}\n      onPointerMove={trackPointer}\n    >\n      <motion.div\n        className=\"pointer-events-none absolute inset-0\"\n        variants={{ rest: { opacity: 0.5 }, hover: { opacity: 0.12 } }}\n        transition={{ duration: reducedMotion ? 0 : 0.25 }}\n      >\n        <Image src={artwork} fill unoptimized sizes=\"(max-width: 896px) 100vw, 896px\" alt={alt}\n          className=\"select-none object-contain\" />\n      </motion.div>\n      <motion.div\n        aria-hidden=\"true\"\n        className=\"pointer-events-none absolute inset-0\"\n        variants={{ rest: { opacity: 0 }, hover: { opacity: 1 } }}\n        transition={{ duration: reducedMotion ? 0 : 0.25 }}\n        style={{ maskImage: mask, WebkitMaskImage: mask }}\n      >\n        <Image src={artwork} fill unoptimized sizes=\"640px\" alt=\"\" className=\"select-none object-contain\" />\n      </motion.div>\n    </motion.div>\n  );\n});\n",
      "type": "registry:component",
      "target": "@components/hangry-ui/components/spotlight-reveal.tsx"
    },
    {
      "path": "registry/lib/typography.shared.ts",
      "content": "/** Shared text hierarchy for documentation and component content. */\nexport const typography = {\n  pageTitle: \"text-4xl font-semibold tracking-tight text-foreground sm:text-5xl\",\n  sectionTitle: \"text-2xl font-semibold tracking-tight text-foreground\",\n  subsectionTitle: \"text-xl font-semibold tracking-tight text-foreground\",\n  body: \"text-base leading-7 text-muted-foreground\",\n  label: \"text-sm font-medium\",\n  caption: \"text-sm leading-6 text-muted-foreground\",\n} as const;\n",
      "type": "registry:lib",
      "target": "@components/hangry-ui/lib/typography.shared.ts"
    },
