      "path": "hangry/components/iphone-17.tsx",
      "content": "import { memo, useId, type ReactNode } from \"react\";\n\nconst finishes = {\n  sage: { body: \"#bdc8b2\", edge: \"#747e6b\", light: \"#e6ebdf\", accent: \"#789479\" },\n  lavender: { body: \"#d6cfe6\", edge: \"#898096\", light: \"#f0eaf7\", accent: \"#9a83be\" },\n  \"mist-blue\": { body: \"#c4d2df\", edge: \"#788796\", light: \"#edf3f7\", accent: \"#7e9fbf\" },\n  black: { body: \"#343535\", edge: \"#151616\", light: \"#747878\", accent: \"#707e8c\" },\n  white: { body: \"#e8e8e3\", edge: \"#9b9c97\", light: \"#ffffff\", accent: \"#a4adb6\" },\n} as const;\n\ninterface IPhone17Props {\n  color?: keyof typeof finishes;\n  className?: string;\n  label?: string;\n  children?: ReactNode;\n}\n\nexport const IPhone17 = memo(function IPhone17({\n  color = \"sage\",\n  className = \"\",\n  label = \"iPhone 17 front illustration\",\n  children,\n}: IPhone17Props = {}) {\n  const id = useId();\n  const finish = finishes[color];\n  const ref = (name: string) => `url(#${id}-${name})`;\n\n  return (\n    <svg\n      role={children != null ? \"group\" : \"img\"}\n      aria-labelledby={`${id}-title`}\n      viewBox=\"0 0 360 666\"\n      fill=\"none\"\n      className={`mx-auto h-auto w-full max-w-sm ${className}`}\n    >\n      <title id={`${id}-title`}>{label}</title>\n      <defs>\n        <linearGradient\n          id={`${id}-frame`}\n          x1=\"0\"\n          y1=\"0\"\n          x2=\"280\"\n          y2=\"580\"\n          gradientUnits=\"userSpaceOnUse\"\n        >\n          <stop stopColor={finish.light} />\n          <stop offset=\"0.15\" stopColor={finish.edge} />\n          <stop offset=\"0.48\" stopColor={finish.body} />\n          <stop offset=\"0.72\" stopColor={finish.light} />\n          <stop offset=\"1\" stopColor={finish.edge} />\n        </linearGradient>\n        <linearGradient\n          id={`${id}-glass`}\n          x1=\"30\"\n          y1=\"15\"\n          x2=\"250\"\n          y2=\"570\"\n          gradientUnits=\"userSpaceOnUse\"\n        >\n          <stop stopColor=\"white\" stopOpacity=\"0.24\" />\n          <stop offset=\"0.5\" stopColor=\"white\" stopOpacity=\"0\" />\n          <stop offset=\"1\" stopColor=\"white\" stopOpacity=\"0.07\" />\n        </linearGradient>\n        <linearGradient\n          id={`${id}-screen`}\n          x1=\"30\"\n          y1=\"0\"\n          x2=\"250\"\n          y2=\"580\"\n          gradientUnits=\"userSpaceOnUse\"\n        >\n          <stop stopColor={finish.light} />\n          <stop offset=\"0.45\" stopColor={finish.body} />\n          <stop offset=\"1\" stopColor={finish.accent} />\n        </linearGradient>\n        <linearGradient\n          id={`${id}-ribbon`}\n          x1=\"80\"\n          y1=\"180\"\n          x2=\"270\"\n          y2=\"470\"\n          gradientUnits=\"userSpaceOnUse\"\n        >\n          <stop stopColor={finish.light} />\n          <stop offset=\"0.5\" stopColor={finish.accent} />\n          <stop offset=\"1\" stopColor=\"#1c3735\" />\n        </linearGradient>\n        <radialGradient id={`${id}-lens`}>\n          <stop stopColor=\"#353966\" />\n          <stop offset=\"0.5\" stopColor=\"#152f3b\" />\n          <stop offset=\"1\" stopColor=\"#080d16\" />\n        </radialGradient>\n        <filter\n          id={`${id}-shadow`}\n          x=\"-50%\"\n          y=\"-25%\"\n          width=\"200%\"\n          height=\"160%\"\n          colorInterpolationFilters=\"sRGB\"\n        >\n          <feDropShadow dx=\"8\" dy=\"24\" stdDeviation=\"18\" floodColor=\"#000\" floodOpacity=\"0.35\" />\n        </filter>\n        <clipPath id={`${id}-display`}>\n          <rect x=\"11\" y=\"11\" width=\"258\" height=\"564\" rx=\"39\" />\n        </clipPath>\n      </defs>\n\n      {/* Front device: thin bezel, Dynamic Island, and an original abstract wallpaper. */}\n      <g transform=\"translate(40 40)\" filter={ref(\"shadow\")}>\n        <rect x=\"-2\" y=\"96\" width=\"4\" height=\"27\" rx=\"2\" fill={finish.edge} />\n        <rect x=\"-2\" y=\"145\" width=\"4\" height=\"45\" rx=\"2\" fill={finish.edge} />\n        <rect x=\"-2\" y=\"201\" width=\"4\" height=\"45\" rx=\"2\" fill={finish.edge} />\n        <rect x=\"278\" y=\"154\" width=\"4\" height=\"64\" rx=\"2\" fill={finish.edge} />\n        <rect x=\"278\" y=\"352\" width=\"4\" height=\"48\" rx=\"2\" fill={finish.edge} />\n        <rect\n          width=\"280\"\n          height=\"586\"\n          rx=\"47\"\n          fill={ref(\"frame\")}\n          stroke={finish.light}\n          strokeOpacity=\"0.6\"\n        />\n        <rect x=\"4\" y=\"4\" width=\"272\" height=\"578\" rx=\"43\" fill=\"#080a09\" stroke=\"#151a17\" />\n        <g clipPath={ref(\"display\")}>\n          {children != null ? (\n            <foreignObject x=\"11\" y=\"11\" width=\"258\" height=\"564\">\n              <div\n                data-slot=\"iphone-screen\"\n                className=\"h-full w-full overflow-y-auto bg-background text-foreground [scrollbar-width:none]\"\n              >\n                {children}\n              </div>\n            </foreignObject>\n          ) : (\n            <g>\n              <rect x=\"11\" y=\"11\" width=\"258\" height=\"564\" fill={ref(\"screen\")} />\n              <path\n                d=\"M-60 465C10 205 199 191 279 316c66 103-57 188-141 159-86-30-38-132 29-104 43 18 7 70-19 51\"\n                stroke={ref(\"ribbon\")}\n                strokeWidth=\"91\"\n              />\n              <path\n                d=\"M-60 465C10 205 199 191 279 316c66 103-57 188-141 159-86-30-38-132 29-104 43 18 7 70-19 51\"\n                stroke={finish.light}\n                strokeOpacity=\"0.65\"\n                strokeWidth=\"2\"\n              />\n              <rect x=\"11\" y=\"11\" width=\"258\" height=\"564\" fill={ref(\"glass\")} />\n              <text\n                x=\"140\"\n                y=\"106\"\n                textAnchor=\"middle\"\n                fill=\"#1c302b\"\n                fontFamily=\"system-ui, sans-serif\"\n                fontSize=\"13\"\n                fontWeight=\"500\"\n              >\n                Wednesday, September 17\n              </text>\n              <text\n                x=\"140\"\n                y=\"177\"\n                textAnchor=\"middle\"\n                fill=\"#1c302b\"\n                fontFamily=\"system-ui, sans-serif\"\n                fontSize=\"74\"\n                fontWeight=\"600\"\n                letterSpacing=\"-5\"\n              >\n                9:41\n              </text>\n              <g fill=\"#fff\" fillOpacity=\"0.16\" stroke=\"#fff\" strokeOpacity=\"0.2\">\n                <circle cx=\"53\" cy=\"527\" r=\"19\" />\n                <circle cx=\"227\" cy=\"527\" r=\"19\" />\n              </g>\n              <path\n                d=\"M49 521h8l-2 5v9h-4v-9l-2-5Zm1-3h6\"\n                stroke=\"#fff\"\n                strokeWidth=\"1.5\"\n                strokeLinejoin=\"round\"\n              />\n              <rect\n                x=\"218\"\n                y=\"522\"\n                width=\"18\"\n                height=\"12\"\n                rx=\"3\"\n                stroke=\"white\"\n                strokeWidth=\"1.5\"\n              />\n              <circle cx=\"227\" cy=\"528\" r=\"3.5\" stroke=\"white\" strokeWidth=\"1.5\" />\n              <rect x=\"221\" y=\"519\" width=\"6\" height=\"3\" rx=\"1\" fill=\"white\" />\n            </g>\n          )}\n        </g>\n        <rect x=\"97\" y=\"21\" width=\"86\" height=\"25\" rx=\"12.5\" fill=\"#030504\" />\n        <circle cx=\"170\" cy=\"33.5\" r=\"5\" fill={ref(\"lens\")} />\n        <circle cx=\"169\" cy=\"32\" r=\"1.5\" fill=\"#56687c\" opacity=\"0.55\" />\n        <rect x=\"97\" y=\"560\" width=\"86\" height=\"4\" rx=\"2\" fill=\"white\" fillOpacity=\"0.8\" />\n        <path d=\"M4 57v-9C4 24 24 4 48 4h184\" stroke=\"white\" strokeOpacity=\"0.6\" />\n      </g>\n    </svg>\n  );\n});\n",
      "type": "registry:component",
      "target": "@components/hangry-ui/components/iphone-17.tsx"
    }
  ],
